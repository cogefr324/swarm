# Copy this file to .env (same folder) and fill in JWT_SECRET at minimum.

# Any long random string - used to sign login sessions. Example: run `openssl rand -hex 32`
# and paste the result here.
JWT_SECRET=

# Port the server listens on.
PORT=4000

# Which frontend origin is allowed to call this server. For local dev with `npm run dev`
# (Vite's default), this is fine as-is. If you deploy the frontend elsewhere, set this to its URL.
CORS_ORIGIN=http://localhost:5173

# Optional: SMTP settings for sending the "you've signed up" confirmation email. If left blank,
# signup still works fine - the server just skips sending an email and logs a note instead.
# Example using a Gmail account (requires an "app password", not your normal password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_USER=youraddress@gmail.com
#   SMTP_PASS=your-16-char-app-password
#   SMTP_FROM=youraddress@gmail.com
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=


# ---- Token verification (copycat / scam filter before the gem finder buys) ----
# Optional free RPC. Leave blank to use the free public Solana RPCs. A Helius FREE-tier key is fine too;
# never put a paid plan here. Keys stay in this file (environment variables) - never in the code.
SOLANA_RPC_URL=
HELIUS_API_KEY=
# Every threshold can be overridden here as VERIFY_<NAME>, e.g.:
# VERIFY_MODE=dry-run                 (log decisions, never block)
# VERIFY_MIN_LIQUIDITY_USD=25000
# VERIFY_MIN_PAIR_AGE_MIN=30
# VERIFY_MIN_UNIQUE_BUYERS=100
# VERIFY_MAX_TOP10_PCT=45
# VERIFY_MAX_CREATOR_PCT=10
# VERIFY_MIN_LIQ_RATIO_VS_LEADER=0.2
# VERIFY_REQUIRE_LP_BURNED=true
# Or put them in server/data/verify-config.json as {"min_liquidity_usd": 15000}


# ---- Holder-cluster / bundle rug check ----
# Always on (free): RugCheck insider networks + top-holder concentration hide obvious rugs from every list.
# Optional: Bubblemaps Data API (https://docs.bubblemaps.io, key from pro.bubblemaps.io). It is credit-based and
# has no documented free tier, so it is OFF unless you set a key. Key stays here, never in the code.
BUBBLEMAPS_API_KEY=
# BUBBLEMAPS_DAILY_CREDITS=2500      (hard cap per day; one coin check costs ~25 credits)
# BUBBLEMAPS_PER_CYCLE=3             (max coins checked per 12s feed refresh)
# BUBBLEMAPS_USE_MAP=1               (1 = also read the bubble-map clusters, ~50 credits per coin; 0 = metrics only, ~25)
# BUBBLEMAPS_TTL_MIN=60
# BUBBLE_MAX_BUNDLES=0.20            (hide if bundled wallets hold > 20% of supply)
# BUBBLE_MAX_CLUSTER=0.25  BUBBLE_MAX_TOP10=0.60  BUBBLE_MAX_FRESH=0.40  BUBBLE_MIN_SCORE=0
# RC_MAX_INSIDER_PCT=50  RC_MAX_TOP10_PCT=70


# ---- Hidden-bundle detection (FREE) ----
# Conyr free tier: self-serve key, no card (https://conyr.ai/api). ~10 requests/min, so the server queues/caches calls.
# Without a key the RPC wallet-cluster heuristic is used (slower, free public RPC / Helius FREE key only).
CONYR_API_KEY=
# CONYR_PER_MIN=8   CONYR_TTL_MIN=20   CONYR_FEED_MAX_PCT=25 (hide from lists above this bundled %)
# Pre-buy thresholds (verifier): VERIFY_BUNDLE_REVIEW_PCT=10  VERIFY_BUNDLE_BLOCK_PCT=15  VERIFY_BUNDLE_STRONG_PCT=25
# VERIFY_CLUSTER_MAX_PCT=12  VERIFY_CLUSTER_MAX_CONNECTED_TOP20=8  VERIFY_CLUSTER_LAUNCH_WINDOW_S=45
# VERIFY_BUNDLE_FAIL_OPEN=false   (true = still buy when neither Conyr nor the RPC check could run)
# VERIFY_MODE=dry-run             (log every bundle decision without blocking - recommended first)

# Console noise: set LOG_VERBOSE=1 to see every API warning again
# LOG_VERBOSE=0


# ---- On-chain hidden-bundle scan (free RPC only, no third-party API) ----
# Trending / New only show coins that passed it; Top hides confirmed bundles. Optional: a Helius FREE key in HELIUS_API_KEY
# makes it faster. Tuning (defaults shown):
# BUNDLE_MAX_CLUSTER_PCT=12  BUNDLE_MAX_CONNECTED=8  BUNDLE_LAUNCH_WINDOW_S=45  BUNDLE_FUND_WINDOW_S=120
# BUNDLE_WALLETS=12  BUNDLE_CONCURRENCY=2  BUNDLE_OK_TTL_MIN=30
# TOP_MIN_VOLUME_USD=100000  TOP_MIN_TXNS=500   (Top list needs at least this much 24h volume / trades)

# ---- Fake-volume (wash trading) detector: free GeckoTerminal trades + free RPC ----
# WASH_MAX_PCT=35 (hide if more than this % of volume is round-tripped)  WASH_MAX_TOP5_PCT=70  WASH_MIN_UNIQUE_RATIO=0.2


# ---- Hosting (Railway) ----
# DATABASE_URL=postgres://...        (Railway adds this for you when you attach a Postgres database; leave blank locally to use files)
# SIGNUP_DISABLED=1                  (close signups, e.g. while you test with friends)
# INVITE_CODE=somecode               (signup needs this code; the sign-up form does not ask for it yet - use SIGNUP_DISABLED or tell me to add the field)
# PGSSL=disable                      (only if your database refuses SSL)

# ---- Only-green chart detector (GeckoTerminal candles) ----
# CHART_MIN_GAIN=0.2  CHART_MAX_DD=0.10  CHART_MIN_EFF=0.5  CHART_MIN_GREEN=0.85
# TOP_MIN_VOLUME_USD=30000  TOP_MIN_TXNS=100
